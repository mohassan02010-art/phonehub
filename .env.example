# Phone Hub Website — Environment Configuration
# Copy this file to .env to configure optional backend services.

# Server Port (when running standalone Express production server)
PORT=3001

# Optional: Gemini API Key (Backend-only, never exposed to browser code)
# Leave blank to run Phone Hub in standard deterministic mode without AI assistance.
GEMINI_API_KEY=

# Optional: Gemini Model Override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
